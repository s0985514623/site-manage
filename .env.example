# ---------- 資料庫 ----------
# 本機開發：docker compose up -d 後即為此連線字串（port 5433 避開既有 Postgres）
DATABASE_URL="postgresql://site_support:local_dev_only@localhost:5433/site_support"

# ---------- 應用程式 ----------
APP_URL="http://localhost:3000"
TZ="Asia/Taipei"

# ---------- 登入（Auth.js + Google）----------
# 產生方式：openssl rand -base64 32
AUTH_SECRET=""
# Google Cloud Console → API 與服務 → 憑證 → 建立 OAuth 用戶端 ID（網頁應用程式）
# 授權重新導向 URI：http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# 允許登入的 Email，多筆以逗號分隔。留空則所有人都無法登入
ALLOWED_EMAILS="you@example.com"

# ---------- 加密（憑證、EPP Code、OAuth token）----------
# !!! 極重要 !!!
# 產生方式：openssl rand -base64 32
# 這把金鑰一旦遺失，所有已加密的主機帳密、網域 Auth Code 將「永久無法還原」。
# 請務必離線另存一份（密碼管理器 / 紙本），且絕不可提交進 git。
# 更換金鑰前必須先用舊金鑰解密全部資料再重新加密，否則資料等同銷毀。
ENCRYPTION_KEY=""

# ---------- 排程保護 ----------
# 產生方式：openssl rand -hex 32
# 所有 /api/cron/* 端點需帶 Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# ---------- 寄信（Resend）----------
RESEND_API_KEY=""
# 寄件人需為已在 Resend 驗證的網域，並設定好 SPF / DKIM，否則會進垃圾桶
MAIL_FROM="報價通知 <notice@yourdomain.com>"
# 系統到期彙總通知的收件人（你自己）
NOTIFY_TO="you@example.com"

# ---------- LINE Messaging API ----------
# LINE Developers Console → Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
# 只有這個 userId 按下的「確認寄出」才會被接受。
# 取得方式：加官方帳號好友後傳一則訊息，看 /api/line/webhook 的 log
LINE_ADMIN_USER_ID=""

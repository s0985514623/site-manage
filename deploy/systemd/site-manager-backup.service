# /etc/systemd/system/site-manager-backup.service
# 每日 pg_dump 本 app 的 database，保留 14 天（見 deploy/backup.sh）。
[Unit]
Description=Backup site-manager PostgreSQL database
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
ExecStart=/opt/my-services/apps/site-manager/backup.sh

{
  "name": "site-support",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "db:reset": "tsx --conditions=react-server scripts/reset.ts",
    "verify:queries": "tsx --conditions=react-server scripts/verify-queries.ts",
    "verify:logic": "tsx --conditions=react-server scripts/verify-logic.ts",
    "verify:scan": "tsx --conditions=react-server scripts/verify-scan.ts",
    "verify": "npm run verify:logic && npm run verify:queries && npm run verify:scan && npm run verify:quotes && npm run verify:credentials && npm run verify:attachments && npm run verify:font",
    "verify:quotes": "tsx --conditions=react-server scripts/verify-quotes.ts",
    "build:fonts": "python scripts/build-fonts.py",
    "verify:font": "node scripts/verify-font-embed.mjs",
    "db:seed-company": "tsx --conditions=react-server scripts/seed-company.ts",
    "pdf:preview": "node scripts/preview-pdf.mjs",
    "verify:detect": "tsx --conditions=react-server scripts/verify-detect.ts",
    "verify:credentials": "tsx --conditions=react-server scripts/verify-credentials.ts",
    "template:import": "python scripts/make-import-template.py",
    "db:import": "node scripts/import-xlsx.mjs",
    "verify:attachments": "tsx --conditions=react-server scripts/verify-attachments.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage-map": "tsx scripts/check-feature-coverage.ts",
    "line:richmenu": "node scripts/line-richmenu.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.6",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.30.0",
    "server-only": "^0.0.1",
    "whoiser": "^2.0.0-beta.10",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
